{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Siada Hub - Default",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/siada/entrypoint/siadahub.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "--workspace",
                "/Users/zhangmeng20/vscodeProject/test",
                "--provider", "openrouter",
                "--model", "claude-sonnet-4",
            ]
        },
        {
            "name": "Siada Hub - Verbose Mode",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/siada/entrypoint/siadahub.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "--verbose",
                "--agent", "coder"
            ]
        },
        {
            "name": "Siada Hub - No Interactive Mode",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/siada/entrypoint/siadahub.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "--agent", "coder",
                "--model", "claude-sonnet-4",
                "--prompt", "使用search工具搜索sort关键词",
                "--provider", "li",
                "--model", "claude-sonnet-4",
                "--workspace", "/Users/zhangmeng20/vscodeProject/test",
            ]
        },
        {
            "name": "Siada Hub - Debug Mode",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/siada/entrypoint/siadahub.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": [
                "--verbose",
                "--fancy-input",
                "--agent", "coder",
                "--pretty", "false"
            ]
        }
    ]
} 