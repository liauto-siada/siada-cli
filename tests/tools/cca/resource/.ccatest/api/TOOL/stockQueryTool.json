{
    "name": "GetStockInfo",
    "description": "商业财经股票查询工具，了解股市动态。支持根据股票名称或代码查询最高价、最低价、市盈率等技术指标，支持查询A股、港股的实时行情和美股历史行情",
    "type": "tool",
    "input_schema": {
        "type": "object",
        "properties": {
            "refText": {
                "type": "string",
                "description": "查询文本，例如：查一下理想现在的股价、苹果股票最新行情、000001股票信息等",
                "example": "查一下理想现在的股价"
            },
            "Vehicle": {
                "type": "string",
                "description": "股票查询API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/stock",
                "default": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/stock"
            },
            "Cloud": {
                "type": "string",
                "description": "股票查询API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/speech/stock",
                "default": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/speech/stock"
            }
        },
        "required": ["refText", "apiUrl"]
    },
