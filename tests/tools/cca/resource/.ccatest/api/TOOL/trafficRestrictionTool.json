{
    "name": "GetTrafficRestrictionInfo",
    "description": "根据查询文本进行交通限行情况查询，支持常见限行城市的交通限行情况查询，可以根据日期、星期、节日、节气查询某个城市的交通限行情况",
    "type": "tool",
    "input_schema": {
        "type": "object",
        "properties": {
            "refText": {
                "type": "string",
                "description": "查询文本，例如：北京明天限行吗、上海今天限行、广州限行情况等",
                "example": "北京明天限行吗"
            },
            "apiUrl": {
                "type": "string",
                "description": "交通限行查询API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/trafficRestriction",
                "default": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/trafficRestriction"
            }
        },
        "required": ["refText", "apiUrl"]
    },
