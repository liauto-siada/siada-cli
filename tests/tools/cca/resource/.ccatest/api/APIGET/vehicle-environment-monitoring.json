{
    "name": "get_vehicle_environment_monitoring",
    "description": "获取车辆内外部环境监测数据。返回内容包括：车内温度(°C)、车内后排温度(°C)、车外温度(°C)、车内湿度(%)、车内空气质量PM2.5浓度(μg/m³)、车内二氧化碳浓度(ppm)等6项环境指标的实时数值，用于评估车内外环境舒适度和空气质量状况。",
    "type": "skill",
    "field_names": {
        "ACIncarTemp": "车内温度",
        "RearACIncarTemp": "后排温度",
        "DspOtsdTemp": "车外温度",
        "InCarHumidity": "车内湿度",
        "AcAirPm25Value": "PM2.5",
        "AcAirCo2Value": "二氧化碳"
    },
    "input_schema": {
        "type": "string",
        "description": "环境监测类型，指定要获取的监测数据类型，与输出参数一一对应",
        "example": "ACIncarTemp",
        "enum": ["ACIncarTemp", "RearACIncarTemp", "DspOtsdTemp", "InCarHumidity", "AcAirPm25Value", "AcAirCo2Value"],
        "enumDescriptions": {
            "ACIncarTemp": "获取车内温度数据",
            "RearACIncarTemp": "获取车内后排温度数据", 
            "DspOtsdTemp": "获取车外温度数据",
            "InCarHumidity": "获取车内相对湿度数据",
            "AcAirPm25Value": "获取车内PM2.5空气质量数据",
            "AcAirCo2Value": "获取车内空调净化运行时二氧化碳浓度数据"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "状态码",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "ACIncarTemp": {
                        "type": ["float", "null"],
                        "description": "车内温度(°C)",
                        "example": "30.0",
                        "range": "-40 ~ 85"
                    },
                    "RearACIncarTemp": {
                        "type": ["float", "null"],
                        "description": "车内后排温度(°C)",
                        "example": "30.0",
                        "range": "-40 ~ 85"
                    },
                    "DspOtsdTemp": {
                        "type": ["float", "null"],
                        "description": "车外温度(°C)",
                        "example": "30.0",
                        "range": "-40 ~ 85"
                    },
                    "InCarHumidity": {
                        "type": ["int", "null"],
                        "description": "车内相对湿度(%)",
                        "example": "10",
                        "range": "0-126"
                    },
                    "AcAirPm25Value": {
                        "type": ["int", "null"],
                        "description": "空调净化运行时车内空气质量PM2.5(μg/m³)",
                        "example": "200",
                        "range": "0-999"
                    },
                    "AcAirCo2Value": {
                        "type": ["int", "null"],
                        "description": "车内二氧化碳浓度(ppm)",
                        "example": "500",
                        "range": ">0"
                    }
                }
            }
        }
    }
} 