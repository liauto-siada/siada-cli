{
  "compilerOptions": {
    /* —— 构建与输出 —— */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo", // 增量编译缓存文件
    "target": "ES2020",                                   // 生成的 JS 目标版本
    "useDefineForClassFields": true,                      // 类字段使用 define 语义
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2023"],   // 注入的类型库
    "module": "ESNext",                                   // 生成的模块格式
    "skipLibCheck": true,                                 // 跳过库文件检查（放过检查）
    "moduleResolution": "bundler",                        // 适配现代打包器解析策略
    "allowImportingTsExtensions": true,                   // 允许导入 .ts/.tsx 扩展名
    "verbatimModuleSyntax": true,                         // 保留原始 import/export 语法
    "moduleDetection": "force",                           // 将所有文件视为模块
    "noEmit": true,                                       // 仅做类型检查，不生成输出
    "jsx": "react-jsx",                                   // React 17+ JSX 转换

    /* ===================================================== *
     *                    ① 开 启 的 检 查                   *
     * ===================================================== */
    "strict": true,               // 开启所有严格类型检查
    "isolatedModules": true,      // 每个文件独立编译，确保与打包器一致

    /* ===================================================== *
     *          ② 放 过 检 查 / 允 许 的 配 置               *
     * ===================================================== */
    "noUnusedLocals": false,                    // 允许未使用的局部变量
    "noUnusedParameters": false,                // 允许未使用的参数
    "noFallthroughCasesInSwitch": false,        // 允许 switch case 穿透
    "noUncheckedSideEffectImports": false,      // 不检查仅副作用导入
    "noImplicitAny": false,                     // 允许隐式 any
    "noImplicitThis": false,                    // 允许隐式 this
    "noImplicitReturns": false,                 // 允许函数隐式返回
    "noImplicitOverride": false,                // 子类覆写无需显式 override
    "strictNullChecks": false,                  // 关闭严格空值检查
    "strictBindCallApply": false,               // 关闭 bind/call/apply 严格检查
    "strictFunctionTypes": false,               // 关闭函数参数协变检查
    "strictPropertyInitialization": false,      // 关闭属性初始化检查
    "exactOptionalPropertyTypes": false,        // 关闭精确可选属性类型检查
    "noUncheckedIndexedAccess": false,          // 关闭索引 |undefined 检查
    "noPropertyAccessFromIndexSignature": false,// 允许通过索引签名访问属性
    "useUnknownInCatchVariables": false,        // catch 变量可用 any
    "allowUnreachableCode": true,               // 允许不可达代码
    "allowUnusedLabels": true,                  // 允许未使用标签
    "alwaysStrict": false,                      // 文件无需自动 strict mode
    "forceConsistentCasingInFileNames": false,  // 不检查文件名大小写一致性
    "checkJs": false,                           // 不检查 .js 文件
    "allowArbitraryExtensions": true,           // 允许任意后缀文件（.svg/.css/.json/.md 等）

    /* —— 全局类型 —— */
    "types": ["vite/client"], // 仅注入这些全局类型声明包（如 import.meta/env）

    /* —— 路径解析 —— */
    "baseUrl": ".",           // 模块解析根路径
    "paths": {
      "@/*": ["./src/*"],
      "@/image": ["./src/image/*"]
    }
  },

  /* —— 包含 / 排除文件 —— */
  "include": [
    "src/**/*",
    "src/templates/**/*",
    "src/lib/**/*",
    "src/hooks/**/*",
    "src/gesture_animation/**/*",
    "src/cards/**/*",
    "src/components/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
