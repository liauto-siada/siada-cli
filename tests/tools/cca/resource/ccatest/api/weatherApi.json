                                "description": "七日全天风力预报",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "date": {"type": ["string", "null"], "description": "日期", "example": "2025-06-25T00:00+08:00"},
                                        "max": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "最大风速(m/s)", "example": "19.43"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "136.59"}}},
                                        "min": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "最小风速(m/s)", "example": "5.12"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "118.69"}}},
                                        "avg": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "平均风速(m/s)", "example": "9.19"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "122.35"}}}
                                    }
                                }
                            },
                            "wind_08h_20h": {
                                "type": ["array", "null"],
                                "description": "七日白天风力预报(08:00-20:00)",
                                "items": {
