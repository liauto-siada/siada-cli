                            "wind_20h_32h": {
                                "type": ["array", "null"],
                                "description": "七日夜间风力预报(20:00-次日08:00)",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "date": {"type": ["string", "null"], "description": "日期", "example": "2025-06-25T00:00+08:00"},
                                        "max": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "最大风速(m/s)", "example": "19.43"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "136.59"}}},
                                        "min": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "最小风速(m/s)", "example": "7.53"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "104.75"}}},
                                        "avg": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "平均风速(m/s)", "example": "11.12"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "117.05"}}}
