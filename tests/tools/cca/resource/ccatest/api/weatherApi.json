                            "temperature_20h_32h": {
                                "type": ["array", "null"],
                                "description": "七日夜间温度预报(20:00-次日08:00)",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "date": {"type": ["string", "null"], "description": "日期", "example": "2025-06-25T00:00+08:00"},
                                        "max": {"type": ["string", "null"], "description": "最高温度(°C)", "example": "33.5"},
                                        "min": {"type": ["string", "null"], "description": "最低温度(°C)", "example": "24.0"},
                                        "avg": {"type": ["string", "null"], "description": "平均温度(°C)", "example": "27.28"}
                                    }
                                }
                            },
                            "wind": {
