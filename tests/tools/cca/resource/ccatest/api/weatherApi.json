                                    "properties": {
                                        "date": {"type": ["string", "null"], "description": "日期", "example": "2025-06-25T00:00+08:00"},
                                        "max": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "最大风速(m/s)", "example": "8.76"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "141.64"}}},
                                        "min": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "最小风速(m/s)", "example": "5.12"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "118.69"}}},
                                        "avg": {"type": "object", "properties": {"speed": {"type": ["string", "null"], "description": "平均风速(m/s)", "example": "6.56"}, "direction": {"type": ["string", "null"], "description": "风向(°)", "example": "129.95"}}}
                                    }
                                }
