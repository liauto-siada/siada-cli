{
    "name": "get_navigation_information",
    "description": "获取车辆导航信息接口。该API提供车辆导航信息，包括：导航目的地名称、导航剩余时间、导航预计到达时间等信息。该接口适用于车载导航系统、导航辅助应用、导航服务模块等场景，用于实时获取车辆导航信息，并显示在手机上。返回数据实时性强，可用于导航显示、导航服务、导航辅助等功能模块。",
    "type": "skill",
    "field_names": {
        "DestinationPoiName": "导航目的地",
        "RemainTime": "导航剩余时间",
        "ArrivalTime": "导航预计到达时间"
    },
    "input_schema": {
        "type": "string",
        "description": "导航信息参数，用于指定需要获取的具体数据类型。该参数采用枚举值形式，每个枚举值对应一种特定的导航信息。通过传入不同的参数值，可以精确获取所需数据项，避免不必要数据传输。参数值与API返回的data对象中的字段名称一一对应，确保数据获取的准确性和一致性。",
        "example": "DestinationPoiName",
        "enum": [
            "DestinationPoiName", "RemainTime", "ArrivalTime"
        ],
        "enumDescriptions": {
            "DestinationPoiName": "获取导航目的地名称",
            "RemainTime": "获取导航剩余时间",
            "ArrivalTime": "获取导航预计到达时间"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "状态码",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "DestinationPoiName": {
                        "type": ["string", "null"],
                        "description": "获取导航目的地名称，非空字符串",
                        "example": "理想汽车北京华贸零售中心"
                    },
                    "RemainTime": {
                        "type": ["int", "null"],
                        "description": "获取导航剩余时间，单位为秒，整数值",
                        "example": "1912",
                        "range": ">=0"
                    },
                    "ArrivalTime": {
                        "type": ["int", "null"],
                        "description": "获取导航预计到达时间，单位为秒，整数值",
                        "example": "",
                        "range": ""
                    }
                }
            }

        }
    }
} 