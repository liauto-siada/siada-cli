import React, { useState, useEffect, useCallback } from 'react'
import { StrictMode, useRef,} from 'react'
import { Button } from "@/components/ui/button"
import { createRoot } from 'react-dom/client'
import '../index.css'
import { ScrollArea } from '@/components/ui/scroll-area'
import titleTipIcon from '@/drawable/title_tip.svg'

${componentCode}

const App = () => {
  const [showTipModal, setShowTipModal] = useState(false)
  const modalRef = useRef<HTMLDivElement>(null)

  // 处理弹层外部点击
  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (modalRef.current && !modalRef.current.contains(event.target as Node)) {
        setShowTipModal(false)
      }
    }

    if (showTipModal) {
      document.addEventListener('mousedown', handleClickOutside)
    }

    return () => {
      document.removeEventListener('mousedown', handleClickOutside)
    }
  }, [showTipModal])

  const handleTipClick = () => {
    setShowTipModal(true)
  }

  return (
    <div className="w-[933px] h-[1360px] bg-slate-200 rounded-[20px] py-[60px] relative flex flex-col">
      {/* 游戏标题区域 */}
      <div className="px-[60px] mb-[132px] flex items-center flex-shrink-0">
        <h1 className="text-8xl font-bold text-gray-800">${title}</h1>
        <button
          onClick={handleTipClick}
          className="ml-[30px] w-[60px] h-[60px] flex items-center justify-center hover:opacity-80 transition-opacity"
        >
          <img
            src={titleTipIcon}
            alt="提示"
            width="60"
            height="60"
          />
        </button>
      </div>
      <div className="flex-1 px-[60px] min-h-0">
        <${componentName} />
      </div>

      {/* 提示弹层 - 覆盖整个区域 */}
      {showTipModal && (
        <div className="absolute inset-0 bg-opacity-30 flex justify-center z-50" style={{ paddingTop: '180px' }}>
          <div
            ref={modalRef}
            className="w-[813px] h-[470px] bg-[#E8EDF3] rounded-[20px] p-[50px] shadow-lg flex flex-col"
          >
            <h2 className="text-4xl font-bold text-gray-900 mb-[30px] flex-shrink-0">
              {/* 游戏介绍标题 */}
              ${gameIntroductionTitle}
            </h2>
            <div className="text-2xl text-gray-600 leading-relaxed flex-1 overflow-y-auto scrollbar-hide">
              <p>
                {/* 游戏介绍 */}
                ${gameIntroduction}
              </p>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

const rootElement = document.getElementById('root')
if (rootElement) {
  createRoot(rootElement).render(
    <StrictMode>
      <App />
    </StrictMode>
  )
}
