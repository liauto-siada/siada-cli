{
    "name": "set_vehicle_fragrance_system",
    "description": "设置香氛功能，包括香氛开关和香氛通道选择。通过传入特定的 type 完成设置。",
    "type": "skill",
    "field_names": {
      "CarControlTpuPlugin_PerfumeSw": "香氛",
      "CarControlTpuPlugin_PerfumeSelectChannel": "当前使用香型"
    },
    "input_schema": {
      "type": "string",
      "description": "指定要设置的香氛功能",
      "example": "CarControlTpuPlugin_PerfumeSw",
      "enum": ["CarControlTpuPlugin_PerfumeSw", "CarControlTpuPlugin_PerfumeSelectChannel"],
      "enumDescriptions": {
          "CarControlTpuPlugin_PerfumeSw": "设置香氛开关状态，0: 关闭，1: 打开",
          "CarControlTpuPlugin_PerfumeSelectChannel": "设置香氛通道，0: 未选中，1: 通道一，2: 通道二，3: 通道三"
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "设置是否成功",
          "example": true
        },
        "code": {
          "type": "integer",
          "description": "状态码，0 表示成功",
          "example": 0
        },
        "message": {
          "type": "string",
          "description": "附加信息说明",
          "example": "设置成功"
        }
      }
    }
  }
  