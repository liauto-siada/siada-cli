                                        "example": "汇率查询"
                                    },
                                    "nlgLanguageClass": {
                                        "type": "string",
                                        "description": "自然语言生成的语言类别",
                                        "example": "putonghua"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
