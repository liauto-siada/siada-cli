{
    "name": "GetExchangeRateInfo",
    "description": "根据查询文本进行常用货币之间的实时汇率查询和货币兑换查询，支持美元、欧元、英镑、日元等主要货币与人民币之间的汇率查询",
    "type": "tool",
    "input_schema": {
        "type": "object",
        "properties": {
            "refText": {
                "type": "string",
                "description": "查询文本，例如：查一下美元的汇率、欧元兑换人民币汇率、100美元等于多少人民币等",
                "example": "查一下美元的汇率"
            },
            "apiUrl": {
                "type": "string",
                "description": "汇率API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/exchangeRate",
                "default": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/exchangeRate"
            }
        },
        "required": ["refText", "apiUrl"]
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "业务状态码，0表示成功",
                "example": 0
            },
            "msg": {
                "type": "string",
                "description": "结果描述",
                "example": "成功"
            },
            "data": {
                "type": "object",
                "properties": {
                    "recordId": {
                        "type": "string",
                        "description": "记录ID",
                        "example": "da1504ee3fd94282b8d5035988df6b3d"
                    },
                    "requestId": {
                        "type": "string",
                        "description": "请求ID",
                        "example": "da1504ee3fd94282b8d5035988df6b3d"
                    },
                    "skill": {
                        "type": "string",
                        "description": "技能名称",
                        "example": "汇率"
                    },
                    "contextId": {
                        "type": "string",
                        "description": "上下文ID",
                        "example": "da1504ee3fd94282b8d5035988df6b3d"
                    },
                    "sessionId": {
                        "type": "string",
                        "description": "会话ID",
                        "example": "da1504ee3fd94282b8d5035988df6b3d"
                    },
                    "skillId": {
                        "type": "string",
                        "description": "技能ID",
                        "example": "2022032100000016"
                    },
                    "speakUrl": {
                        "type": "string",
                        "description": "语音播报URL",
                        "example": "https://dds-ack.dui.ai/runtime/v1/cache/0145d49ff519472aa7a0856dae99b05f?productId=279630977&aispeech-da-env=hd-ack"
                    },
                    "ttsSampleRate": {
                        "type": "integer",
                        "description": "TTS采样率",
                        "example": 16000
                    },
                    "dm": {
                        "type": "object",
                        "properties": {
                            "taskId": {
                                "type": "string",
                                "description": "任务ID",
                                "example": "62383858b973a600012b8b44"
                            },
                            "intentId": {
                                "type": "string",
                                "description": "意图ID",
                                "example": "640074ef66923800012feb97"
                            },
                            "input": {
                                "type": "string",
                                "description": "输入文本",
                                "example": "查一下美元的汇率"
                            },
                            "shouldEndSession": {
                                "type": "boolean",
                                "description": "是否应该结束会话",
                                "example": true
                            },
                            "status": {
                                "type": "integer",
                                "description": "状态码",
                                "example": 1
