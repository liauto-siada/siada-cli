                                                "example": "人民币"
                                            },
                                            "from": {
                                                "type": "string",
                                                "description": "源货币名称",
                                                "example": "美元"
                                            },
                                            "fromNumber": {
                                                "type": "string",
                                                "description": "源货币数量",
                                                "example": "1"
                                            },
                                            "toCode": {
                                                "type": "string",
                                                "description": "目标货币代码",
                                                "example": "RMB"
                                            }
                                        }
                                    }
                                }
                            },
                            "context": {
                                "type": "object",
                                "properties": {
                                    "currentIntentName": {
