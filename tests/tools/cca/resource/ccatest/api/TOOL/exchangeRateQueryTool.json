                                        "description": "组件名称",
                                        "example": "default"
                                    },
                                    "errorCode": {
                                        "type": "integer",
                                        "description": "错误代码",
                                        "example": 0
                                    },
                                    "widgetName": {
                                        "type": "string",
                                        "description": "组件名称",
                                        "example": "default"
                                    },
                                    "extra": {
                                        "type": "object",
                                        "properties": {
                                            "date": {
                                                "type": "string",
                                                "description": "汇率日期",
                                                "example": "2025-06-30"
