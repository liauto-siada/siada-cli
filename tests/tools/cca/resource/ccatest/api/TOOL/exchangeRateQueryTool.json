                            "nlg": {
                                "type": "string",
                                "description": "汇率信息的自然语言描述",
                                "example": "根据中国银行外汇牌价，目前美元兑换人民币汇率为7.16"
                            },
                            "intentName": {
                                "type": "string",
                                "description": "意图名称",
                                "example": "汇率查询"
                            },
                            "task": {
                                "type": "string",
