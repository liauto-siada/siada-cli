{
    "name": "GetWordInfo",
    "description": "单词查询工具，可以根据输入的文本查询相关的英语单词信息，包括释义、音标、例句等",
    "type": "tool",
    "input_schema": {
        "type": "object",
        "properties": {
            "vector": {
                "type": "string",
                "description": "查询文本，例如：帮我生成苹果的单词、查找关于动物的单词等",
                "example": "帮我生成苹果的单词"
            },
            "topK": {
                "type": "integer",
                "description": "返回结果数量，默认为1，最大建议不超过10",
                "example": 2,
                "default": 1,
                "minimum": 1,
                "maximum": 10
            },
            "Vehicle": {
                "type": "string",
                "description": "单词查询API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/knowledge/word",
                "default": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/knowledge/word"
            },
            "Cloud": {
                "type": "string",
                "description": "单词查询API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/knowledge/word",
                "default": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/knowledge/word"
            }
        },
        "required": ["vector"]
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "业务状态码，0表示成功",
                "example": 0
            },
            "msg": {
                "type": "string",
                "description": "返回消息",
                "example": "成功"
            },
            "data": {
                "type": "object",
                "description": "返回的数据主体",
                "properties": {
                    "vfsData": {
                        "type": "array",
                        "description": "向量化数据结果列表",
                        "items": {
                            "type": "object",
                            "properties": {
                                "text": {
                                    "type": "string",
                                    "description": "单词文本内容",
                                    "example": "单词:abandon|释义:放弃(信念);(不顾责任、义务等)离弃,抛弃;抛弃;(不得已而)舍弃,丢弃,离开;停止(支持或帮助);中止;陷入,沉湎于(某种情感)"
                                },
                                "score": {
                                    "type": "number",
                                    "description": "相似度分数",
                                    "example": 0.6949999809265137
                                },
                                "knowledgeChunkId": {
                                    "type": "string",
                                    "description": "知识块ID",
                                    "example": "e818cab1fa5445ae8dc9bdd2499a98b0"
                                },
                                "distance": {
                                    "type": ["number", "null"],
                                    "description": "距离值",
                                    "example": null
                                },
                                "fields": {
                                    "type": "object",
                                    "description": "字段信息",
                                    "properties": {
                                        "bizExtraPayload": {
                                            "type": "string",
                                            "description": "业务扩展载荷JSON字符串",
                                            "example": "{\"exampleList\":[{\"sample\":\"Their decision to abandon the trip was made becauseof financial constraints:\",\"translate\":\"他们决定放弃这次出游是因为财力有限。\"}]}"
                                        },
                                        "createTime": {
                                            "type": "string",
                                            "description": "创建时间",
                                            "example": "1751533737000"
                                        },
                                        "sound": {
                                            "type": "string",
                                            "description": "音标",
                                            "example": "/a'bændenden/"
                                        },
                                        "translation": {
                                            "type": "string",
                                            "description": "翻译",
                                            "example": "vt.  放弃(信念);(不顾责任、义务等)离弃,遗弃,抛弃;(不得已而)舍弃,丢弃,离开;停止(支持或帮助);中止;陷入,沉湎于(某种情感) n.放任;放纵"
                                        },
                                        "TEXT": {
                                            "type": "string",
                                            "description": "文本内容",
                                            "example": "单词:abandon|释义:放弃(信念);(不顾责任、义务等)离弃,抛弃;抛弃;(不得已而)舍弃,丢弃,离开;停止(支持或帮助);中止;陷入,沉湎于(某种情感)"
                                        },
                                        "category": {
                                            "type": "string",
                                            "description": "分类",
                                            "example": "英语四级"
                                        },
                                        "VECTOR": {
                                            "type": "string",
                                            "description": "向量",
                                            "example": ""
                                        }
                                    }
                                },
                                "bizExtraPayload": {
                                    "type": "object",
                                    "description": "业务扩展载荷对象",
                                    "properties": {
                                        "exampleList": {
                                            "type": "array",
                                            "description": "例句列表",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "sample": {
                                                        "type": "string",
                                                        "description": "例句",
                                                        "example": "Their decision to abandon the trip was made becauseof financial constraints:"
                                                    },
                                                    "translate": {
                                                        "type": "string",
                                                        "description": "翻译",
                                                        "example": "他们决定放弃这次出游是因为财力有限。"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "bizExtraId": {
                                    "type": ["string", "null"],
                                    "description": "业务扩展ID",
                                    "example": null
                                },
                                "bizCreateTime": {
                                    "type": ["string", "null"],
                                    "description": "业务创建时间",
                                    "example": null
                                }
                            }
                        }
                    },
                    "graphData": {
                        "type": "array",
                        "description": "图形数据",
                        "example": []
                    }
                }
            }
        }
    }
} 