{
    "name": "GetCalendarInfo",
    "description": "根据查询文本进行日历相关信息查询。支持查询节日节气对应的阴历阳历日期、具体日期对应的节日节气、星座日期、生肖年份、当前北京时间、星期对应的日期、距离某节日天数、指定年份月份天数、生肖对应的年份年龄等信息",
    "type": "tool",
    "input_schema": {
        "type": "object",
        "properties": {
            "refText": {
                "type": "string",
                "description": "查询文本，例如：三月十五日是什么节日、中秋节那天是星期几、现在几点、今天是什么星座、距离春节还有几天等",
                "example": "中秋节那天是星期几"
            },
            "Vehicle": {
                "type": "string",
                "description": "日历API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/calendar",
                "default": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/calendar"
            },
            "Cloud": {
                "type": "string",
                "description": "日历API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/speech/calendar",
                "default": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/speech/calendar"
            }
        },
        "required": ["refText", "apiUrl"]
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "业务状态码，0表示成功",
                "example": 0
            },
            "msg": {
                "type": "string",
                "description": "结果描述",
                "example": "成功"
            },
            "data": {
                "type": "object",
                "properties": {
                    "recordId": {
                        "type": "string",
                        "description": "记录ID",
                        "example": "3e6bce2984734b4f843fe5ae00b266d4"
                    },
                    "requestId": {
                        "type": "string",
                        "description": "请求ID",
                        "example": "3e6bce2984734b4f843fe5ae00b266d4"
                    },
                    "skill": {
                        "type": "string",
                        "description": "技能名称",
                        "example": "日历"
                    },
                    "contextId": {
                        "type": "string",
                        "description": "上下文ID",
                        "example": "3e6bce2984734b4f843fe5ae00b266d4"
                    },
                    "dm": {
                        "type": "object",
                        "description": "对话管理信息",
                        "properties": {
                            "taskId": {
                                "type": "string",
                                "description": "任务ID",
                                "example": "5c8f78384b2e84000dd87072"
                            },
                            "intentId": {
                                "type": "string",
                                "description": "意图ID",
                                "example": "672c2d5e76e12e0001983a2f"
                            },
                            "nlg": {
                                "type": "string",
                                "description": "日历信息描述",
                                "example": "中秋节是星期一"
                            },
                            "input": {
                                "type": "string",
                                "description": "用户输入",
                                "example": "中秋节那天是星期几"
                            },
                            "widget": {
                                "type": "object",
                                "description": "组件信息",
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "description": "组件类型",
                                        "example": "text"
                                    },
                                    "text": {
                                        "type": "string",
                                        "description": "日期文本",
                                        "example": "10月6日"
                                    },
                                    "extra": {
                                        "type": "object",
                                        "description": "额外信息",
                                        "properties": {
                                            "weekday": {
                                                "type": "string",
                                                "description": "星期",
                                                "example": "星期一"
                                            },
                                            "constellation": {
                                                "type": "string",
                                                "description": "星座",
                                                "example": "天秤座"
                                            },
                                            "constellationBegin": {
                                                "type": "string",
                                                "description": "星座起始日期",
                                                "example": "9月23日"
                                            },
                                            "constellationEnd": {
                                                "type": "string",
                                                "description": "星座结束日期",
                                                "example": "10月23日"
                                            },
                                            "cinstellation": {
                                                "type": "string",
                                                "description": "星座(兼容字段)",
                                                "example": "天秤座"
                                            },
                                            "nlDay": {
                                                "type": "string",
                                                "description": "农历日",
                                                "example": "十五"
                                            },
                                            "month": {
                                                "type": "integer",
                                                "description": "月份",
                                                "example": 10
                                            },
                                            "negative": {
                                                "type": "boolean",
                                                "description": "是否为负数",
                                                "example": false
                                            },
                                            "daysInterval": {
                                                "type": "integer",
                                                "description": "天数间隔",
                                                "example": 75
                                            },
                                            "festival": {
                                                "type": "string",
                                                "description": "节日",
                                                "example": "中秋节"
                                            },
                                            "year": {
                                                "type": "integer",
                                                "description": "年份",
                                                "example": 2025
                                            },
                                            "day": {
                                                "type": "integer",
                                                "description": "日期",
                                                "example": 6
                                            },
                                            "solarTerm": {
                                                "type": "string",
                                                "description": "节气",
                                                "example": ""
                                            },
                                            "nlMonth": {
                                                "type": "string",
                                                "description": "农历月",
                                                "example": "八月"
                                            },
                                            "zodiac": {
                                                "type": "string",
                                                "description": "生肖",
                                                "example": "蛇"
                                            },
                                            "nlYear": {
                                                "type": "string",
                                                "description": "农历年",
                                                "example": "乙巳"
                                            }
                                        }
                                    },
                                    "duiWidget": {
                                        "type": "string",
                                        "description": "DUI组件类型",
                                        "example": "text"
                                    },
                                    "widgetName": {
                                        "type": "string",
                                        "description": "组件名称",
                                        "example": "default"
                                    },
                                    "name": {
                                        "type": "string",
                                        "description": "名称",
                                        "example": "default"
                                    }
                                }
                            },
                            "context": {
                                "type": "object",
                                "description": "上下文信息",
                                "properties": {
                                    "currentIntentName": {
                                        "type": "string",
                                        "description": "当前意图名称",
                                        "example": "查询星期"
                                    },
                                    "nlgLanguageClass": {
                                        "type": "string",
                                        "description": "语言类型",
                                        "example": "putonghua"
                                    }
                                }
                            },
                            "task": {
                                "type": "string",
                                "description": "任务类型",
                                "example": "日历"
                            },
                            "intentName": {
                                "type": "string",
                                "description": "意图名称",
                                "example": "查询星期"
                            },
                            "status": {
                                "type": "integer",
                                "description": "状态码",
                                "example": 1
                            },
                            "shouldEndSession": {
                                "type": "boolean",
                                "description": "是否应结束会话",
                                "example": true
                            }
                        }
                    },
                    "sessionId": {
                        "type": "string",
                        "description": "会话ID",
                        "example": "3e6bce2984734b4f843fe5ae00b266d4"
                    },
                    "skillId": {
                        "type": "string",
                        "description": "技能ID",
                        "example": "2019031800001161"
                    },
                    "speakUrl": {
                        "type": "string",
                        "description": "语音播报URL",
                        "example": "https://dds-ack.dui.ai/runtime/v1/cache/cf219afc41e948958304a8b527584451?productId=279630977&aispeech-da-env=hd-ack"
                    },
                    "ttsSampleRate": {
                        "type": "integer",
                        "description": "语音采样率",
                        "example": 16000
                    }
                }
            }
        }
    }
} 