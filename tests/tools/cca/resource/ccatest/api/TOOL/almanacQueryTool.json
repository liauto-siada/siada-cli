                "example": "查询今天黄历"
            },
            "Vehicle": {
                "type": "string",
                "description": "黄历API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/almanac",
                "default": "https://crs-hmi-testtwo.chehejia.com/crs-mindcloud-api/api/v1/tool/speech/almanac"
            },
            "Cloud": {
                "type": "string",
                "description": "黄历API服务器地址，必须传入完整的API端点地址。",
                "example": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/speech/almanac",
                "default": "https://crs-mindcloud-service-testtwo.inner.chj.cloud/api/v1/tool/speech/almanac"
            }
        },
        "required": ["refText", "apiUrl"]
