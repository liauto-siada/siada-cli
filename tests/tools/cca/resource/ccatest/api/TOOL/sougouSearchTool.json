{
    "name": "sougouSearchTool",
    "description": "根据关键词进行搜狗搜索，获取相关网页内容、图片链接和网站信息",
    "type": "tool",
    "input_schema": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "description": "搜索关键词，用于搜索相关内容",
                "example": "OpenAI GPT-4"
            }
        },
        "required": ["query"]
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "业务状态码，0表示成功",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "原始搜索关键词",
                        "example": "OpenAI GPT-4"
                    },
                    "docs": {
                        "type": "array",
                        "description": "搜索结果文档列表",
                        "items": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string",
                                    "description": "网页标题",
                                    "example": "OpenAI发布GPT-4最新版本"
                                },
                                "url": {
                                    "type": "string",
                                    "description": "网页链接地址",
                                    "example": "https://example.com/openai-gpt4"
                                },
                                "passage": {
                                    "type": "string",
                                    "description": "网页摘要内容，可能包含多个段落",
                                    "example": "OpenAI今日发布了GPT-4的最新版本，具有更强的推理能力..."
                                },
                                "score": {
                                    "type": "number",
                                    "description": "搜索结果相关性评分",
                                    "example": 0.95
                                },
                                "date": {
                                    "type": "string",
                                    "description": "发布日期，格式为YYYY-MM-DD HH:MM:SS",
                                    "example": "2024-01-15 10:30:00"
                                },
                                "site": {
                                    "type": "string",
                                    "description": "网站名称",
                                    "example": "TechNews"
                                },
                                "images": {
                                    "type": "array",
                                    "description": "相关图片链接列表",
                                    "items": {
                                        "type": "string"
                                    },
                                    "example": ["https://example.com/image1.jpg", "https://example.com/image2.jpg"]
                                },
                                "favicon": {
                                    "type": "string",
                                    "description": "网站图标链接",
                                    "example": "https://example.com/favicon.ico"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
} 