{
    "name": "get_bind_trip",
    "description": "获取车辆陪伴里程信息相关数据。该API提供车辆陪伴里程信息，包含车辆AD行程总里程、最远AD行程里程、最远AD行程时长、最远AD行程占比、NOA行程里程、ACC行程里程、LCC行程里程、AVP行程里程、通过路口次数、成功变道次数、避让绕行次数、应对加塞次数、VLM次数、通过收费站次数、接管次数、复杂场景次数、AD行驶天数、AD行驶天数占比、NOA行驶天数占比、ACC行驶里程占比、LCC行驶里程占比、AD行驶里程占比、陪伴总里程、陪伴CD里程、陪伴CS里程、行驶天数、总驾驶时长、总CD驾驶时长、总CS驾驶时长等信息。支持按需获取特定类型的陪伴相关数据，适用于车辆状态监控和驾驶辅助应用等场景。返回数据为车辆陪伴信息的实时信息，可用于仪表盘显示和车辆健康监测等功能模块。",
    "type": "skill",
    "field_names": {
    },
    "input_schema": {
        "type": "string",
        "description": "获取车辆陪伴里程信息相关数据类型。该参数采用枚举值形式，每个枚举值对应一种特定的陪伴信息。通过传入不同的参数值，可以精确获取所需数据项，避免不必要数据传输。参数值与API返回的data对象中的字段名称一一对应，确保数据获取的准确性和一致性。",
        "example": "adMileage",
        "enum": [
            "adMileage", "maxAdMileage", "maxAdDuration", "maxAdRatio", "noaMileage", 
            "accMileage", "lccMileage", "avpMileage", "passCross",
            "laneChange", "laneAvoid", "cutInLine", "vlm", "passTollGate", "takeOver", 
            "complexScenes", "adDays", "adDaysRatio", "noaRatio", 
            "accRatio", "lccRatio", "adRatio", "mileage", "mileageCd", "mileageCs", 
            "drivingDays", "drivingDuration","drivingDurationCd", "drivingDurationCs"
        ],
        "enumDescriptions": {
            "adMileage": "获取AD行程总里程",
            "maxAdMileage": "获取最远AD行程里程",
            "maxAdDuration": "获取最远AD行程时长",
            "maxAdRatio": "获取最远AD行程占比",

            "noaMileage": "获取NOA行程里程",
            "accMileage": "获取ACC行程里程",
            "lccMileage": "获取LCC行程里程",
            "avpMileage": "获取AVP行程里程",

            "passCross": "获取通过路口次数",
            "laneChange": "获取成功变道次数",
            "laneAvoid": "获取避让绕行LANE_AVOID次数",
            "cutInLine": "获取应对加塞次数",
            "vlm": "获取VLM次数",
            "passTollGate": "获取通过收费站次数",
            "takeOver": "获取接管次数",
            "complexScenes": "获取复杂场景次数",

            "adDays": "获取AD行驶天数",
            "adDaysRatio": "获取AD行驶天数占比",

            "noaRatio": "获取NOA行驶里程占比",
            "accRatio": "获取ACC行驶里程占比",
            "lccRatio": "获取LCC行驶里程占比",
            "adRatio": "获取AD行驶里程占比",

            "mileage": "获取陪伴总里程",
            "mileageCd": "获取陪伴CD里程",
            "mileageCs": "获取陪伴CS里程",

            "drivingDays": "获取行驶天数",

            "drivingDuration": "获取总驾驶时长",
            "drivingDurationCd": "获取总CD驾驶时长",
            "drivingDurationCs": "获取总CS驾驶时长"
        }
    },
