{
    "name": "get_interior_lighting_system",
    "description": "获取车内各个位置阅读灯和照明设备的控制状态信息。返回内容包括：主驾阅读灯开关状态(开启/关闭)、副驾阅读灯开关状态(开启/关闭)、二排左阅读灯开关状态(开启/关闭)、二排右阅读灯开关状态(开启/关闭)、三排左阅读灯开关状态(开启/关闭)、三排右阅读灯开关状态(开启/关闭)、三排中阅读灯开关状态(开启/关闭/无此功能)等7项车内照明设备的独立控制状态。",
    "type": "skill",
    "field_names": {
        "ReadingLight_FL": "主驾阅读灯",
        "ReadingLight_FR": "副驾阅读灯",
        "ReadingLight_SecL": "二排左阅读灯",
        "ReadingLight_SecR": "二排右阅读灯",
        "ReadingLight_ThirdL": "三排左阅读灯",
        "ReadingLight_ThirdR": "三排右阅读灯",
        "ReadingLight_ThirdM": "三排中阅读灯"
    },
    "input_schema": {
        "type": "string",
        "description": "车内照明控制类型，指定要获取的控制数据类型，与输出参数一一对应",
        "example": "ReadingLight_FL",
        "enum": ["ReadingLight_FL", "ReadingLight_FR", "ReadingLight_SecL", "ReadingLight_SecR", "ReadingLight_ThirdL", "ReadingLight_ThirdR", "ReadingLight_ThirdM"],
        "enumDescriptions": {
            "ReadingLight_FL": "获取主驾阅读灯开关状态",
            "ReadingLight_FR": "获取副驾阅读灯开关状态",
            "ReadingLight_SecL": "获取二排左阅读灯开关状态",
            "ReadingLight_SecR": "获取二排右阅读灯开关状态",
            "ReadingLight_ThirdL": "获取三排左阅读灯开关状态",
            "ReadingLight_ThirdR": "获取三排右阅读灯开关状态",
            "ReadingLight_ThirdM": "获取三排中阅读灯开关状态"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "状态码",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "ReadingLight_FL": {
                        "type": ["string", "null"],
                        "description": "主驾阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "ReadingLight_FR": {
                        "type": ["string", "null"],
                        "description": "副驾阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "ReadingLight_SecL": {
                        "type": ["string", "null"],
                        "description": "二排左阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "ReadingLight_SecR": {
                        "type": ["string", "null"],
                        "description": "二排右阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "ReadingLight_ThirdL": {
                        "type": ["string", "null"],
                        "description": "三排左阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "ReadingLight_ThirdR": {
                        "type": ["string", "null"],
                        "description": "三排右阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "ReadingLight_ThirdM": {
                        "type": ["string", "null"],
                        "description": "三排中阅读灯开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    }
                }
            }
        }
    }
} 