{
    "name": "get_rear_hvac_control",
    "description": "获取第二排（后排）空调系统的独立控制状态信息。返回内容包括：后排空调总开关状态(开启/关闭)、后排自动空调开关状态(开启/关闭)、后排空调温度设置值(°C)、后排空调自动风量档位(1-7档)、后排空调手动风量档位(1-7档)、后排空调吹风方向模式等6项后排空调独立控制参数的实时状态。",
    "type": "skill",
    "field_names": {
        "RearAcSw": "后排空调开关",
        "RearAcAuto": "后排空调自动开关",
        "RearAcTemp": "后排温度",
        "RearAcWindAuto": "后排空调自动风量",
        "RearAcWind": "后排空调手动风量",
        "RearAcWindDirection": "后排吹风方向"
    },
    "input_schema": {
        "type": "string",
        "description": "后排空调控制类型，指定要获取的控制数据类型，与输出参数一一对应",
        "example": "RearAcSw",
        "enum": ["RearAcSw", "RearAcAuto", "RearAcTemp", "RearAcWindAuto", "RearAcWind", "RearAcWindDirection"],
        "enumDescriptions": {
            "RearAcSw": "获取后排空调开关状态",
            "RearAcAuto": "获取后排空调自动开关状态",
            "RearAcTemp": "获取后排空调温度设置",
            "RearAcWindAuto": "获取后排空调自动风量档位",
            "RearAcWind": "获取后排空调手动风量档位",
            "RearAcWindDirection": "获取后排空调吹风方向模式"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "状态码",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "RearAcSw": {
                        "type": ["string", "null"],
                        "description": "后排空调开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "RearAcAuto": {
                        "type": ["string", "null"],
                        "description": "后排空调自动开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "RearAcTemp": {
                        "type": ["float", "null"],
                        "description": "后排空调温度设置(°C)",
                        "example": "25",
                        "range": ""
                    },
                    "RearAcWindAuto": {
                        "type": ["int", "null"],
                        "description": "后排空调自动风量档位",
                        "example": "1",
                        "range": "1-9"
                    },
                    "RearAcWind": {
                        "type": ["int", "null"],
                        "description": "后排空调手动风量档位",
                        "example": "1",
                        "range": "1-5"
                    },
                    "RearAcWindDirection": {
                        "type": ["int", "null"],
                        "description": "前排空调吹风方向模式，1:吹脸，2:吹脸&吹脚，3:吹脚，4:吹脚&吹窗，5:吹窗，6:吹脸&吹窗，7:吹脸&吹脚&吹窗",
                        "example": "1",
                        "range": "1-7"
                    }
                }
            }
        }
    }
} 