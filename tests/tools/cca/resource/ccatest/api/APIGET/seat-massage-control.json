{
    "name": "get_seat_massage_control",
    "description": "获取座椅按摩功能开关的状态信息。返回内容包括：主驾座椅按摩开关状态(开启/关闭)、副驾座椅按摩开关状态(开启/关闭)、二排左座椅按摩开关状态(开启/关闭)、二排右座椅按摩开关状态(开启/关闭)等4项座椅按摩功能的基础开关控制状态，用于启停各个座椅的按摩功能。",
    "type": "skill",
    "field_names": {
        "Switch_FL": "主驾座椅按摩",
        "Switch_FR": "副驾座椅按摩",
        "Switch_SecL": "二排左侧座椅按摩",
        "Switch_SecR": "二排右侧座椅按摩"
    },
    "input_schema": {
        "type": "string",
        "description": "座椅按摩控制类型，指定要获取的控制数据类型，与输出参数一一对应",
        "example": "Switch_FL",
        "enum": ["Switch_FL", "Switch_FR", "Switch_SecL", "Switch_SecR"],
        "enumDescriptions": {
            "Switch_FL": "获取主驾座椅按摩开关状态",
            "Switch_FR": "获取副驾座椅按摩开关状态",
            "Switch_SecL": "获取二排左座椅按摩开关状态",
            "Switch_SecR": "获取二排右座椅按摩开关状态"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "状态码",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "Switch_FL": {
                        "type": ["string", "null"],
                        "description": "主驾座椅按摩开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "Switch_FR": {
                        "type": ["string", "null"],
                        "description": "副驾座椅按摩开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "Switch_SecL": {
                        "type": ["string", "null"],
                        "description": "二排左座椅按摩开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "Switch_SecR": {
                        "type": ["string", "null"],
                        "description": "二排右座椅按摩开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    }
                }
            }
        }
    }
} 