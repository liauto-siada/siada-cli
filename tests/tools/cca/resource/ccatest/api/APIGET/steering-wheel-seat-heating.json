{
    "name": "get_steering_wheel_seat_heating",
    "description": "获取方向盘加热和前排座椅加热功能的状态信息。返回内容包括：方向盘加热开关状态(开启/关闭)、方向盘加热自动调节状态(开启/关闭)、主驾座椅加热档位(0-3档，0为关闭)、副驾座椅加热档位(0-3档，0为关闭)等4项前排加热功能的当前设置状态，提供冬季驾乘舒适性保障。",
    "type": "skill",
    "field_names": {
        "AcSteeringWheelHeat": "方向盘加热",
        "AcStrWhlSeatAutoHeat": "方向盘及座椅加热自动调节",
        "SeatAcRow1LeftHeat": "主驾座椅加热",
        "SeatAcRow1RightHeat": "副驾座椅加热"
    },
    "input_schema": {
        "type": "string",
        "description": "方向盘座椅加热控制类型，指定要获取的控制数据类型，与输出参数一一对应",
        "example": "AcSteeringWheelHeat",
        "enum": ["AcSteeringWheelHeat", "AcStrWhlSeatAutoHeat", "SeatAcRow1LeftHeat", "SeatAcRow1RightHeat"],
        "enumDescriptions": {
            "AcSteeringWheelHeat": "获取方向盘加热开关状态",
            "AcStrWhlSeatAutoHeat": "获取方向盘加热自动调节状态",
            "SeatAcRow1LeftHeat": "获取主驾座椅加热档位",
            "SeatAcRow1RightHeat": "获取副驾座椅加热档位"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "请求是否成功",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "状态码",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "AcSteeringWheelHeat": {
                        "type": ["string", "null"],
                        "description": "方向盘加热开关状态，0: 关，1: 开",
                        "example": "1",
                        "range": "0-1"
                    },
                    "AcStrWhlSeatAutoHeat": {
                        "type": ["string", "null"],
                        "description": "方向盘加热自动调节状态",
                        "example": "1",
                        "range": "0-1"
                    },
                    "SeatAcRow1LeftHeat": {
                        "type": ["string", "null"],
                        "description": "主驾座椅加热档位，0: 关闭，1: 1档，2: 2档，3: 3档",
                        "example": "0",
                        "range": "0-3"
                    },
                    "SeatAcRow1RightHeat": {
                        "type": ["string", "null"],
                        "description": "副驾座椅加热档位，0: 关闭，1: 1档，2: 2档，3: 3档",
                        "example": "0",
                        "range": "0-3"
                    }
                }
            }
        }
    }
} 