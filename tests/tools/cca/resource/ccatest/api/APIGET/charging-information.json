{
    "name": "get_charging_information",
    "description": "获取车辆充电数据的综合接口。该API提供车辆充电数据的综合数据接口，包括：充电状态、充电开始时间、动力电池内部电压、动力电池内部电流、剩余充电时长、充电上限设置、预约充电开关、充电类型、直流电压（VSS）、直流电流（VSS）、交流电压（VSS）、交流电流（VSS）、电池保温、自动充电预冷/预热、立即预冷/预热等。支持按需获取特定类型的充电相关数据，适用于车载信息系统、驾驶辅助应用、车辆状态监控等场景。返回数据为当前充电状态的实时信息，可用于仪表盘显示、驾驶辅助控制、车辆健康监测等功能模块。",
    "type": "skill",
    "field_names": {
        "ChargeStatus": "充电状态",
        "ChargingStartTime": "充电开始时间",
        "MSG_RESSInterVolt": "动力电池内部电压",
        "DischargeStatus": "动力电池内部电流",
        "ChargeRemainTime": "剩余充电时长",
        "ChargeLimit": "充电上限设置",
        "ReserveSwitchStatus": "预约充电开关",
        "ChargeType": "充电枪连接状态和类型",
        "OGCChargeVoltage": "直流电压",
        "OGCChargeCurrent": "直流电流",
        "ACChargeVoltage": "交流电压",
        "ACChargeCurrent": "交流电流",
        "WarmSwitchStatus": "电池保温",
        "TempControl": "获取自动充电预冷/预热",
        "ManuTempAdjStatus": "获取立即预冷/预热"
    },
    "input_schema": {
        "type": "string",
        "description": "充电类型参数，用于指定需要获取的具体充电数据类型。该参数采用枚举值形式，每个枚举值对应一种特定的充电数据。通过传入不同的参数值，可以精确获取所需的数据项，避免不必要的数据传输。参数值与API返回的data对象中的字段名称一一对应，确保数据获取的准确性和一致性。",
        "example": "ChargeStatus",
        "enum": ["ChargeStatus", "ChargingStartTime", "MSG_RESSInterVolt", "DischargeStatus", "ChargeRemainTime", 
                 "ChargeLimit", "ReserveSwitchStatus", "ChargeType", "OGCChargeVoltage", 
                 "OGCChargeCurrent", "ACChargeVoltage", "ACChargeCurrent", "WarmSwitchStatus",
                 "TempControl", "ManuTempAdjStatus"],
        "enumDescriptions": {
            "ChargeStatus": "获取充电状态",
            "ChargingStartTime": "获取充电开始时间",
            "MSG_RESSInterVolt": "获取动力电池内部电压",
            "DischargeStatus": "获取动力电池内部电流",
            "ChargeRemainTime": "获取剩余充电时长",
            "ChargeLimit": "获取充电上限设置",
            "ReserveSwitchStatus": "获取预约充电开关",
            "ChargeType": "获取充电枪连接状态和类型",
            "OGCChargeVoltage": "获取直流电压",
            "OGCChargeCurrent": "获取直流电流",
            "ACChargeVoltage": "获取交流电压",
            "ACChargeCurrent": "获取交流电流",
            "WarmSwitchStatus": "获取电池保温",
            "TempControl": "获取自动充电预冷/预热状态",
            "ManuTempAdjStatus": "获取立即预冷/预热状态"
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "API调用是否成功的标识，true表示成功获取数据，false表示调用失败或数据获取异常",
                "example": true
            },
            "code": {
                "type": "integer",
                "description": "API返回状态码，0表示成功，非0表示各种错误状态（如网络异常、数据不可用等）",
                "example": 0
            },
            "data": {
                "type": "object",
                "properties": {
                    "ChargeStatus": {
                        "type": ["int", "null"],
                        "description": "充电状态，0x0: 默认 无状态，0x01: 充电枪已连接，0x02: 电池预热，0x03: 充电中，0x04: 电池保温，0x05: 充电停止，0x06: 充电暂停，0x07: 充电错误，0x0F: 充电枪拔出，0x10: 预约充电等待中，0x11: 充电完成。如果数据不可用则返回null",
                        "example": "1",
                        "range": ""
                    },
                    "ChargingStartTime": {
                        "type": ["long", "null"],
                        "description": "充电开始充电时间戳，-1 表示当前没在充电。如果数据不可用则返回null",
                        "example": "1752045092000",
                        "range": ">0"
                    },
                    "MSG_RESSInterVolt": {
                        "type": ["int", "null"],
                        "description": "动力电池内部电压，单位为伏特。如果数据不可用则返回null",
                        "example": "100",
                        "range": "0 ~ 1000"
                    },
                    "DischargeStatus": {
                        "type": ["int", "null"],
                        "description": "动力电池内部电流，单位为安培，电流为负表示充电，使用方自己取绝对值。如果数据不可用则返回null",
                        "example": "100",
                        "range": "-2500 ~ 2500"
                    },
                    "ChargeRemainTime": {
                        "type": ["int", "null"],
                        "description": "剩余充电时长，单位为分钟。无效值：0xFFFF。如果数据不可用则返回null",
                        "example": "100",
                        "range": "非0xFFFF"
                    },
                    "ChargeLimit": {
                        "type": ["int", "null"],
                        "description": "充电上限设置，取值范围80 - 100%。如果数据不可用则返回null",
                        "example": "100",
                        "range": "80 ~ 100"
                    },
                    "ReserveSwitchStatus": {
                        "type": ["int", "null"],
                        "description": "预约充电开关状态，0: 关闭，1: 开启。如果数据不可用则返回null",
                        "example": "1",
                        "range": "0 ~ 1"
                    },
                    "ChargeType": {
                        "type": ["int", "null"],
                        "description": "充电枪连接状态和类型，0:未插枪，慢充（交流枪），2:快充（直流枪）。如果数据不可用则返回null",
                        "example": "1",
                        "range": "0 ~ 2"
                    },
                    "OGCChargeVoltage": {
                        "type": ["int", "null"],
                        "description": "直流电压，单位为伏特。如果数据不可用则返回null",
                        "example": "100",
                        "range": "0 ~ 65534"
                    },
                    "OGCChargeCurrent": {
                        "type": ["int", "null"],
                        "description": "直流电流，单位为安培。如果数据不可用则返回null",
                        "example": "100",
                        "range": "-400 ~ 1000"
                    },
                    "ACChargeVoltage": {
                        "type": ["int", "null"],
                        "description": "交流电压，单位为伏特。如果数据不可用则返回null",
                        "example": "10",
                        "range": "-30 ~ 63"
                    },
                    "ACChargeCurrent": {
                        "type": ["int", "null"],
                        "description": "交流电流，单位为安培，无效值:0x3FF。如果数据不可用则返回null",
                        "example": "10",
                        "range": "0 ~ 4094"
                    },
                    "WarmSwitchStatus": {
                        "type": ["int", "null"],
                        "description": "电池保温状态，0: 关闭，1: 开启。如果数据不可用则返回null",
                        "example": "1",
                        "range": "0-1"
                    },
                    "TempControl": {
                        "type": ["int", "null"],
                        "description": "自动在途温控状态(自动预热预冷)，0: 关闭，1: 开启，但是不在预热预冷中，2: 预热中，3: 预冷中。如果数据不可用则返回null",
                        "example": "1",
                        "range": "0-3"
                    },
                    "ManuTempAdjStatus": {
                        "type": ["int", "null"],
                        "description": "手动在途温控状态(手动预热预冷)，0: 关闭，1: 开启。如果数据不可用则返回null",
                        "example": "1",
                        "range": "0-1"
                    }
                }
            }
        }
    }
}