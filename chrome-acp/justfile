# Build and package the current platform without publishing or modifying Git.
pack: build-all
    node scripts/package-browser.mjs pack

build:
    bun run build:extension

build-proxy:
    rm -rf packages/proxy-server/dist
    bun run build:proxy

build-web:
    bun run build:web

build-all:
    bun run build

test:
    bun run test